<?xml version="1.0" encoding="UTF-8"?>
<!-- The Monokai Pro colours on the dark background libadwaita uses for text views -->
<style-scheme id="crimson-monokai" name="Crimson Monokai" version="1.0">
	<description>Monokai Pro inspired colours that sit well in a libadwaita window</description>

	<color name="background" value="#1e1e1e"/>
	<color name="raised" value="#2a2a2c"/>
	<color name="selected" value="#403e41"/>
	<color name="text" value="#fcfcfa"/>
	<color name="dimmed" value="#939293"/>
	<color name="faint" value="#5b595c"/>
	<color name="comment" value="#727072"/>
	<color name="red" value="#ff6188"/>
	<color name="orange" value="#fc9867"/>
	<color name="yellow" value="#ffd866"/>
	<color name="green" value="#a9dc76"/>
	<color name="cyan" value="#78dce8"/>
	<color name="purple" value="#ab9df2"/>
	<color name="chrome" value="#030303"/>
	<color name="side" value="#151516"/>

	<style name="text" foreground="text" background="background"/>
	<style name="selection" background="selected"/>
	<style name="selection-unfocused" background="raised"/>
	<style name="cursor" foreground="text"/>
	<style name="current-line" background="raised"/>
	<style name="line-numbers" foreground="faint" background="background"/>
	<style name="current-line-number" foreground="dimmed" background="raised" bold="true"/>
	<style name="bracket-match" foreground="yellow" background="selected" bold="true"/>
	<style name="bracket-mismatch" foreground="text" background="red"/>
	<style name="search-match" foreground="background" background="orange"/>
	<style name="right-margin" foreground="text" background="text"/>
	<style name="draw-spaces" foreground="faint"/>
	<style name="crimson:titlebar" foreground="text" background="chrome"/>
	<style name="crimson:statusbar" foreground="dimmed" background="chrome"/>
	<style name="crimson:sidebar" foreground="text" background="side"/>

	<style name="def:comment" foreground="comment" italic="true"/>
	<style name="def:shebang" foreground="comment" bold="true"/>
	<style name="def:doc-comment-element" foreground="dimmed" italic="true"/>
	<style name="def:string" foreground="yellow"/>
	<style name="def:special-char" foreground="purple"/>
	<style name="def:keyword" foreground="red"/>
	<style name="def:statement" foreground="red"/>
	<style name="def:operator" foreground="red"/>
	<style name="def:preprocessor" foreground="red"/>
	<style name="def:type" foreground="cyan" italic="true"/>
	<style name="def:builtin" foreground="cyan"/>
	<style name="def:function" foreground="green"/>
	<style name="def:identifier" foreground="text"/>
	<style name="def:constant" foreground="purple"/>
	<style name="def:special-constant" foreground="purple"/>
	<style name="def:boolean" foreground="purple"/>
	<style name="def:number" foreground="purple"/>
	<style name="def:decimal" foreground="purple"/>
	<style name="def:floating-point" foreground="purple"/>
	<style name="def:base-n-integer" foreground="purple"/>
	<style name="def:character" foreground="yellow"/>
	<style name="def:note" foreground="orange" bold="true"/>
	<style name="def:net-address" foreground="cyan" underline="single"/>
	<style name="def:error" foreground="red" underline="error"/>
	<style name="def:warning" foreground="orange"/>
	<style name="def:heading" foreground="green" bold="true"/>
	<style name="def:emphasis" italic="true"/>
	<style name="def:strong-emphasis" bold="true"/>
	<style name="def:link-text" foreground="cyan"/>
	<style name="def:link-destination" foreground="purple" underline="single"/>
	<style name="def:insertion" foreground="green"/>
	<style name="def:deletion" foreground="red"/>
	<style name="diff:added-line" foreground="green"/>
	<style name="diff:removed-line" foreground="red"/>
	<style name="diff:changed-line" foreground="orange"/>
	<style name="diff:location" foreground="cyan"/>
</style-scheme>
