<?xml version="1.0" encoding="UTF-8"?>
<!-- The Gruvbox palette by morhetz, light variant -->
<style-scheme id="gruvbox-light" name="Gruvbox Light" version="1.0">
	<description>The Gruvbox palette by morhetz, light variant</description>

	<color name="background" value="#fbf1c7"/>
	<color name="raised" value="#ebdbb2"/>
	<color name="selected" value="#d5c4a1"/>
	<color name="text" value="#3c3836"/>
	<color name="dimmed" value="#504945"/>
	<color name="faint" value="#a89984"/>
	<color name="comment" value="#928374"/>
	<color name="keyword" value="#9d0006"/>
	<color name="type" value="#b57614"/>
	<color name="function" value="#79740e"/>
	<color name="string" value="#79740e"/>
	<color name="number" value="#8f3f71"/>
	<color name="builtin" value="#af3a03"/>
	<color name="preprocessor" value="#427b58"/>
	<color name="special" value="#af3a03"/>
	<color name="note" value="#af3a03"/>
	<color name="error" value="#9d0006"/>
	<color name="warning" value="#b57614"/>

	<style name="text" foreground="text" background="background"/>
	<style name="selection" background="selected"/>
	<style name="selection-unfocused" background="raised"/>
	<style name="cursor" foreground="text"/>
	<style name="current-line" background="raised"/>
	<style name="line-numbers" foreground="faint" background="background"/>
	<style name="current-line-number" foreground="dimmed" background="raised" bold="true"/>
	<style name="bracket-match" foreground="note" background="selected" bold="true"/>
	<style name="bracket-mismatch" foreground="background" background="error"/>
	<style name="search-match" foreground="background" background="note"/>
	<style name="right-margin" foreground="text" background="text"/>
	<style name="draw-spaces" foreground="faint"/>

	<style name="def:comment" foreground="comment" italic="true"/>
	<style name="def:shebang" foreground="comment" bold="true"/>
	<style name="def:doc-comment-element" foreground="comment" italic="true"/>
	<style name="def:string" foreground="string"/>
	<style name="def:character" foreground="string"/>
	<style name="def:special-char" foreground="special"/>
	<style name="def:keyword" foreground="keyword"/>
	<style name="def:statement" foreground="keyword"/>
	<style name="def:operator" foreground="keyword"/>
	<style name="def:preprocessor" foreground="preprocessor"/>
	<style name="def:type" foreground="type" italic="true"/>
	<style name="def:builtin" foreground="builtin"/>
	<style name="def:function" foreground="function"/>
	<style name="def:identifier" foreground="text"/>
	<style name="def:constant" foreground="number"/>
	<style name="def:special-constant" foreground="number"/>
	<style name="def:boolean" foreground="number"/>
	<style name="def:number" foreground="number"/>
	<style name="def:decimal" foreground="number"/>
	<style name="def:floating-point" foreground="number"/>
	<style name="def:base-n-integer" foreground="number"/>
	<style name="def:note" foreground="note" bold="true"/>
	<style name="def:net-address" foreground="type" underline="single"/>
	<style name="def:error" foreground="error" underline="error"/>
	<style name="def:warning" foreground="warning"/>
	<style name="def:heading" foreground="function" bold="true"/>
	<style name="def:emphasis" italic="true"/>
	<style name="def:strong-emphasis" bold="true"/>
	<style name="def:link-text" foreground="type"/>
	<style name="def:link-destination" foreground="number" underline="single"/>
	<style name="def:insertion" foreground="function"/>
	<style name="def:deletion" foreground="error"/>
	<style name="diff:added-line" foreground="function"/>
	<style name="diff:removed-line" foreground="error"/>
	<style name="diff:changed-line" foreground="note"/>
	<style name="diff:location" foreground="type"/>
</style-scheme>
